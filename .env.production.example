# ==========================================
# BUDGET TRACKER - PRODUCTION ENVIRONMENT
# ==========================================

# Set to False for production!
DEBUG=False

# Generate a secure random string (e.g. using: openssl rand -base64 48)
SECRET_KEY=replace-with-a-long-random-secret-key-in-production

# Add your Oracle Cloud public IP and custom domain (comma-separated, no spaces)
# Example: 129.146.xxx.xxx,mybudgetapp.com,www.mybudgetapp.com
ALLOWED_HOSTS=127.0.0.1,localhost,your-server-ip-or-domain

# CSRF Trusted Origins for login and form submissions
# Example: http://129.146.xxx.xxx,https://mybudgetapp.com
CSRF_TRUSTED_ORIGINS=http://your-server-ip-or-domain,https://your-server-ip-or-domain

# Default Currency
DEFAULT_CURRENCY=PHP

# PostgreSQL Credentials (used by Docker Compose db service)
POSTGRES_DB=budget_tracker
POSTGRES_USER=budget_user
POSTGRES_PASSWORD=generate_a_strong_password_here
